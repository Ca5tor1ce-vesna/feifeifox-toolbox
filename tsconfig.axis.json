{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "axis-engine/src/**/*.ts",
    "tests/axis/**/*.ts",
    "tools/build_axis_engine.mjs",
    "beta/axis/**/*.ts",
    "beta/tests/**/*.ts"
  ]
}
