{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "types": [],
    "skipLibCheck": true
  },
  "include": [
    "speed-ui/src/**/*.ts",
    "speed-ui/src/**/*.vue",
    "gacha-ui/src/**/*.ts",
    "gacha-ui/src/**/*.vue",
    "records-ui/src/**/*.ts",
    "records-ui/src/**/*.vue",
    "roster-ui/src/**/*.ts",
    "roster-ui/src/**/*.vue",
    "shell/src/**/*.ts",
    "ui-shared/src/**/*.ts",
    "types/browser-globals.d.ts"
  ]
}
