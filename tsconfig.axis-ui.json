{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "types": [],
    "skipLibCheck": true,
    "paths": {
      "@beta-pack": [
        "./axis-ui/src/no-beta.ts"
      ]
    }
  },
  "include": [
    "axis-ui/src/**/*.ts",
    "axis-ui/src/**/*.vue",
    "ui-shared/src/**/*.ts"
  ]
}
